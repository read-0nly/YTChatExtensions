
{

  "browser_specific_settings": {
    "gecko": {
      "id": "ytchat@addon-example",
		"data_collection_permissions": {
		  "required": ["websiteContent","personalCommunications"]
		}
    }
  },
  "background": {
    "scripts": ["Services/ChatHistory.js"]
  },

  "content_security_policy": "script-src 'self'; object-src 'self'",

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "all_frames": true,
      "run_at": "document_end",
      "js": ["Injections/Youtube/ChatSpider.js"]
    }
  ],

  "description": "Chat extension for Youtube",

  "manifest_version": 2,

  "name":"YTChat Extensions",
  "permissions": ["scripting","webNavigation","storage"],

  "version": "0.1.2"

}